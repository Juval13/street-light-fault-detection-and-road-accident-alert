# Root Project Configuration
# Copy this file to .env and update values as needed

# Python Environment
PYTHONPATH=.

# Backend Server
BACKEND_HOST=localhost
BACKEND_PORT=8765

# Frontend
FRONTEND_PORT=3000
REACT_APP_WS_URL=ws://localhost:8765
REACT_APP_ENV=development

# Email Configuration for OTP
# Set EMAIL_ENABLED=true to send real emails, false to show OTP on screen (development mode)
EMAIL_ENABLED=false

# SMTP Settings (Gmail example)
# For Gmail: Use App Password (not your regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com

# Instructions for Gmail Setup:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an App Password for "Mail"
# 5. Copy the 16-character password and use it as SMTP_PASSWORD
